{
  "schema_version": "0.1-discussion-draft",
  "description": "Feature-space seeds defined by analytic surface relations and oriented void-side cells. This file is a design draft and is not yet consumed by the extractors.",
  "surface_graph_schema": {
    "node": {
      "id": "seed-local surface role id",
      "role": "semantic role",
      "surface_type": "plane | cylinder",
      "topology_constraints": "optional periodicity, seam, or trimmed-domain requirements"
    },
    "binary_relation": {
      "faces": "two seed-local node ids",
      "type": "parallel | perpendicular | nonparallel | nonperpendicular | oriented_normals_opposite | tangent | coaxial | axes_parallel | distinct_noncoaxial | radius_equal | radius_different | radius_order | plane_normal_parallel_axis"
    },
    "group_constraint": {
      "type": "closed_oriented_prismatic_section | normal_rank_positive_span | bottom_normal_parallel_group_axis | all_boundaries_active | distinct_support_surfaces | recession_cone_escape",
      "faces": "three or more seed-local node ids when applicable"
    }
  },
  "global_matching_policy": {
    "brep_surface_node": "A BRep graph node stores one analytic support surface and a list of its trimmed topological patches. Each patch keeps face_id, topological orientation/outward normal, UV domain, triangulation samples, and bounding box. A seed node id is only a local semantic role id; an actual face_id appears only in a match mapping.",
    "support_representation": "Keep analytic support equations. Clip a support surface only for Boolean operations or visualization, not for testing analytic relations.",
    "expanded_model_bbox": {
      "relative_margin": 0.05,
      "minimum_margin_model_units": 1.0
    },
    "relation_graph_policy": "Do not create an edge for every pair of intersecting infinite planes. Evaluate discriminative analytic relations lazily during seed backtracking.",
    "distinct_support_surfaces": true,
    "oriented_feature_side": {
      "rule": "topological_outward_normal",
      "plane_implicit_field": "phi(x)=n_canonical dot x-d; choose sigma so grad(sigma*phi) agrees with the mapped topological outward normal",
      "cylinder_implicit_field": "phi(x)=distance_to_axis(x)^2-r^2; choose sigma so grad(sigma*phi) agrees with the mapped topological outward normal",
      "local_halfspace": "H_i={x | sigma_i*phi_i(x)>=epsilon}",
      "common_witness_required": true,
      "all_seed_boundaries_must_be_active": true
    },
    "planar_or_global_cylinder_space": "Use the connected component of the oriented support-cell adjacent to every mapped topological patch.",
    "trimmed_cylinder_space": "For nonperiodic or circular-end cylinder patches, preserve the trimmed UV/angular domain and construct a piecewise oriented boundary cell. A full-cylinder implicit halfspace is not an equivalent replacement.",
    "local_collision_clip": {
      "bbox_source": "all accepted feature-face triangulation vertices and edge samples",
      "relative_margin": 0.001,
      "minimum_margin_model_units": 0.001,
      "surface_inward_epsilon_relative": 1e-06,
      "surface_inward_epsilon_minimum": 1e-05
    },
    "collision_rule": "Volume(local_feature_cell intersect part_solid) <= tolerance",
    "unbounded_escape_rule": "Compute the recession directions of the selected oriented feature cell. Every extreme direction not capped by an active seed surface must remain collision-free from the feature-face envelope until it exits the unexpanded stock envelope. This distinguishes through/passage cells from locally similar but externally blocked cells without introducing topological seed edges.",
    "cavity_evidence_rule": "Volume(local_feature_cell intersect unexpanded_stock_envelope) must be positive; otherwise an exterior stock corner could be mistaken for a machining cavity.",
    "candidate_face_rule": "Extract every unoccupied topological patch cosurface with a matched seed role, with consistent topological orientation, whose complete sampled patch lies on the active boundary of the selected feature cell. Disconnected patches on the same support node are tested independently.",
    "outer_face_reduction_rule": "Do not remove outermost faces greedily merely to force zero collision. Enumerate axis-ordered or spatially connected candidate subsets and retain the maximal collision-free subset that still contains every required seed role and keeps every boundary active."
  },
