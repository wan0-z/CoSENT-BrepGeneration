{
  "schema_version": "1.0-surface-space",
  "description": "Oriented surface-attributed graph seeds. SAG matching locates support surfaces; face constraints select maximal collision-free topological-face sets.",
  "space_models": {
      "global_oriented_support_cell": "Intersection of oriented analytic plane/cylinder regions. Cylinder trim eligibility is independent of this construction.",
      "trimmed_boundary_cell": "A fixed support/trim-branch mapping defines a 2D Minkowski section, extruded along the bottom normal. Selected member faces do not redefine the section."
    },
  "surface_graph_schema": {
    "node": {
      "id": "seed-local role id",
      "role": "geometric role",
      "surface_type": "plane | cylinder",
      "membership": "all strict-cosurface topological faces with the same representative direction"
    },
    "representative_direction": {
      "plane": "oriented topological normal pointing to the selected feature-space side",
      "cylinder": "sigma sign for which sigma*grad(phi) agrees with the topological outward normal; opposite sigma values create separate nodes"
    },
    "edge_code": {
      "format": "five-bit multi-hot abcde",
      "00_plane_plane": "bit3 parallel; bit4 opposite directions when bit3=1; bit5 perpendicular",
      "01_plane_cylinder": "bit3 axis perpendicular to plane normal; bit4 tangent when bit3=1; bit5 axis parallel to plane normal",
      "11_cylinder_cylinder": "bit3 axes parallel; bit4 coaxial when bit3=1; bit5 equal radii"
    },
    "graph_policy": {
      "complete_typed_edges": true,
      "same_underlying_support_nodes_are_not_connected": true,
      "rebuild_after_each_accepted_instance": true
    }
  },
  "matching_policy": {
      "complexity_order": [
        "node_count descending",
        "cylinder_node_count descending",
        "edge_one_bit_sum descending",
        "category_id ascending"
      ],
      "surface_stage": "Group oriented support surfaces, build the SAG, match a seed subgraph, then apply surface/group constraints.",
      "face_stage": "Search still-unlabelled member-face combinations, retain every required role, and accept a maximal valid collision-free set.",
      "collision_policy": {
        "instance_envelope": "AABB in the fixed feature local CRS, enclosing the complete selected topological faces (analytic extrema, or conservative tessellation bounds), not a model-axis AABB.",
        "extension_ratio": 0.1,
        "extension_rule": "For each local axis j: L_j=max_j-min_j; expanded limits are min_j-alpha*L_j and max_j+alpha*L_j. Expand all six sides; lengths become (1+2*alpha)*L_j.",
        "finite_collision_domain": "D_alpha(T)=K intersect {x: expanded_min <= Q^T*(x-o) <= expanded_max}; Q=[e_x e_y e_z], o=model origin. K and Q are fixed for a matched support/trim-branch mapping; only the bbox depends on selected faces T.",
        "degenerate_envelope": "Reject a candidate with zero extent on any local axis within model tolerance; do not silently invent thickness.",
        "test": "Volume(D_alpha(T) intersect part_solid) <= volume_tolerance; apply a model-unit inward geometric offset to true feature boundaries for numerical robustness, not to artificial bbox caps.",
        "semantic_cavity_evidence_required": false
      },
      "ownership_policy": "Label accepted faces, remove them from their surface nodes, delete empty nodes, rebuild the SAG, and continue with the next candidate.",
      "feature_space_construction": {
        "local_crs": "Right-handed orthonormal frame; origin is always model origin (0,0,0). Derive axes once per support/trim-branch match, never per selected face combination. y=normalize(z cross x); project x onto z-perpendicular plane and normalize. A displayed relocated triad is only a direction glyph.",
        "axis_sign": "Align extrusion axes with the bottom normal when present; otherwise use a deterministic canonical sign (largest absolute component positive, ties x/y/z). Stable perpendicular projects the least-aligned model basis vector onto the z-normal plane.",
        "implicit_intersection": "K=intersection_i {x:h_i(x)>=0}. Plane: h_i=n_i dot x-d_i with oriented unit topological normal. Cylinder: h_i=sigma_i*(dist(x,axis_i)^2-r_i^2); sigma_i chosen to agree with topological outward normals. These cylinder regions are not linear halfspaces.",
        "minkowski_extrusion": "In the plane perpendicular to the bottom normal define a filled section C=G (+) disk(r) (+) cone(R), where (+) is Minkowski sum, G is a center point or center segment, and R is empty or one opening ray. K={x: projection(x) in C and n_bottom dot x-d_bottom>=0}. Use filled disks, not just arcs. Empty R means {0}. Centers/radii/bottom and the fixed trim branch come from matched supports, not selected patch extent.",
        "trim_branch": "For a one-cylinder U section, resolve and store the opening ray once from the oriented radial normal at the reference back-arc midpoint of the matched trim branch. Opposite openings are distinct candidates. This reference is not recomputed when patches are added/removed.",
        "boundary_display": "Display true boundaries of K clipped to the display box; do not treat box caps as seed supports. Minkowski tangent continuations can create virtual boundary portions not lying on an original cylinder; retain and label them.",
        "not_recession_cone": "K is a point set retaining support offsets; rec(K) is a direction set and must never replace K in clipping."
      },
      "face_active_boundary": {
        "rule": "For each selected topological face f require a nonempty subset on the active boundary of K, with consistent oriented support. Partial overlap is allowed; whole-face containment is not required.",
        "sampled_minimum_fraction": 0.1,
        "sampling": "At least 10 percent of uniformly distributed face-area samples must lie on the active boundary within model tolerance. This is a practical nonempty-overlap threshold, not an exact equivalence to nonemptiness; a finite sample count is not an exact area measure.",
        "surface_level": "Keep existing surface/group active-boundary tests unchanged, including positive-area support participation."
      },
      "trim_policy": {
        "measure": "Angular Lebesgue measure of the UNION of all selected patches on each specified cylindrical support, projected to its periodic angle circle modulo 2*pi. Merge overlaps and seam splits; do not sum face spans or take the min/max UV range.",
        "scope": "Evaluate independently per cylinder node, after choosing a face combination. Axial trim does not change angular measure.",
        "comparisons": "Every specified cylinder role must have positive occupied angular measure and satisfy its upper/lower comparison; strict < is not <=. Use an explicit angular tolerance without turning equality at pi into a valid strict-less case."
      }
    },
