{
  "schema_version": "1.0-surface-space",
  "description": "Oriented surface-attributed graph seeds. SAG matching locates support surfaces; face constraints select maximal collision-free topological-face sets.",
  "space_models": {
    "global_oriented_support_cell": "Planes and complete cylinders define a cell through oriented analytic support fields.",
    "trimmed_boundary_cell": "At least one trimmed cylinder contributes its finite angular/UV boundary to the cell."
  },
  "surface_graph_schema": {
    "node": {
      "id": "seed-local role id",
      "role": "geometric role",
      "surface_type": "plane | cylinder",
      "trimmed": "whether the finite angular/UV domain is part of the seed",
      "membership": "all strict-cosurface topological faces with the same representative direction"
    },
    "representative_direction": {
      "plane": "oriented topological normal pointing to the selected feature-space side",
      "cylinder": "sigma sign for which sigma*grad(phi) agrees with the topological outward normal; opposite sigma values create separate nodes"
    },
    "edge_code": {
      "format": "five-bit multi-hot abcde",
      "00_plane_plane": "bit3 parallel; bit4 opposite directions when bit3=1; bit5 perpendicular",
      "01_plane_cylinder": "bit3 axis perpendicular to plane normal; bit4 tangent when bit3=1; bit5 axis parallel to plane normal",
      "11_cylinder_cylinder": "bit3 axes parallel; bit4 coaxial when bit3=1; bit5 equal radii"
    },
    "graph_policy": {
      "complete_typed_edges": true,
      "same_underlying_support_nodes_are_not_connected": true,
      "rebuild_after_each_accepted_instance": true
    }
  },
  "matching_policy": {
    "complexity_order": ["node_count descending", "cylinder_node_count descending", "edge_one_bit_sum descending", "category_id ascending"],
    "surface_stage": "Group oriented support surfaces, build the SAG, match a seed subgraph, then apply surface/group constraints.",
    "face_stage": "Search still-unlabelled member-face combinations, retain every required role, and accept a maximal valid collision-free set.",
    "collision_policy": {
      "instance_envelope": "AABB of all proposed instance faces",
      "extension_ratio": 0.1,
      "extension_rule": "extend by 0.1 of the corresponding envelope extent along every required recession direction; through directions extend on both sides",
      "test": "Volume(clipped_recession_volume intersect part_solid) <= tolerance after an inward boundary offset",
      "semantic_cavity_evidence_required": false
    },
    "ownership_policy": "Label accepted faces, remove them from their surface nodes, delete empty nodes, rebuild the SAG, and continue with the next candidate."
  },
